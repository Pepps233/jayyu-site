---
import { BLOG_LANGUAGE_LABELS, getBlogIndexHref, type BlogLanguage, type BlogSection } from '../../lib/blog';

interface Props {
  title: string;
  description?: string;
  label?: string;
  section?: BlogSection;
  language?: BlogLanguage;
  alternateHref?: string;
}

const { title, description, label, section, language = 'en', alternateHref } = Astro.props;
const alternateLanguage = language === 'en' ? 'zh' : 'en';
---

<section class="blog-log-header" lang="en">
  {label && <div class="module-label">{label}</div>}
  <div class="blog-log-header__inner">
    <div>
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
    <div class="blog-log-header__actions">
      {alternateHref ? (
        <a href={alternateHref} class="blog-list-translate no-underline" data-blog-language-link>
          Translate to {BLOG_LANGUAGE_LABELS[alternateLanguage]}
        </a>
      ) : (
        <button type="button" class="blog-list-translate" data-blog-translate-all hidden>
          <span data-blog-list-translate-label>Translate to 中文</span>
        </button>
      )}
      <nav class="blog-topic-toggle" aria-label="Blog topics">
        <a href={getBlogIndexHref('research', language)} class="no-underline" aria-current={section === 'research' ? 'page' : undefined}>Technical</a>
        <a href={getBlogIndexHref('life', language)} class="no-underline" aria-current={section === 'life' ? 'page' : undefined}>Life</a>
      </nav>
    </div>
  </div>
</section>
