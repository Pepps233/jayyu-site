---
import type { BlogSection } from '../../lib/blog';

interface Props {
  title: string;
  description?: string;
  label?: string;
  section?: BlogSection;
}

const { title, description, label, section } = Astro.props as Props;
---

<section class="blog-log-header">
  {label && <div class="module-label">{label}</div>}
  <div class="blog-log-header__inner">
    <div>
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
    <div class="blog-log-header__actions">
      <button type="button" class="blog-list-translate" data-blog-translate-all hidden>
        <span data-blog-list-translate-label>Translate to 中文</span>
      </button>
      <nav class="blog-topic-toggle" aria-label="Blog topics">
        <a href="/blog/" class="no-underline" aria-current={section === 'research' ? 'page' : undefined}>Technical</a>
        <a href="/blog/life/" class="no-underline" aria-current={section === 'life' ? 'page' : undefined}>Life</a>
      </nav>
    </div>
  </div>
</section>
