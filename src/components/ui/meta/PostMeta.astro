---
import { author } from '../../../data/author';
import { slugifyTag } from '../../../lib/slug';

interface Props {
  readingTimeMin: number;
  authorName?: string;
}

const { readingTimeMin, authorName = author.name } = Astro.props as Props;
---

<div class="article-author">
  <img src={author.avatar.src} alt="" width="32" height="32" loading="lazy" />
  <div>
    <a href={`/blog/author/${slugifyTag(authorName)}/`} class="no-underline">{authorName}</a>
    <span class="article-reading-time">{readingTimeMin} min read</span>
  </div>
</div>
