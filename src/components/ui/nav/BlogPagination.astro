---
interface Props {
  currentPage: number;
  totalPages: number;
  firstPagePath?: string;
  basePath?: string; // e.g. '/blog/page'
}

const { currentPage, totalPages, basePath = '/blog/page', firstPagePath = '/blog/' } = Astro.props as Props;
const prevHref = currentPage > 1 ? (currentPage === 2 ? firstPagePath : `${basePath}/${currentPage - 1}/`) : null;
const nextHref = currentPage < totalPages ? `${basePath}/${currentPage + 1}/` : null;
---

{totalPages > 1 && (
  <nav class="mt-6 flex items-center justify-center gap-3" aria-label="Pagination">
    {prevHref ? (
      <a href={prevHref} class="dev-button">Previous</a>
    ) : (
      <span class="dev-button" style="opacity:.5; pointer-events:none;">Previous</span>
    )}
    <span class="status-chip">
      Page {currentPage} of {totalPages}
    </span>
    {nextHref ? (
      <a href={nextHref} class="dev-button">Next</a>
    ) : (
      <span class="dev-button" style="opacity:.5; pointer-events:none;">Next</span>
    )}
  </nav>
)}

