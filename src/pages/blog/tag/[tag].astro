---
import SiteShell from '../../../components/SiteShell.astro';
import BlogLogHeader from '../../../components/blog/BlogLogHeader.astro';
import BlogPostList from '../../../components/blog/BlogPostList.astro';
import { slugifyTag } from '../../../lib/slug';
import { getTagMeta } from '../../../data/tags';
import { getBlogPostGroups } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getBlogPostGroups();
  const tags = [...new Set(posts.flatMap((post) => post.defaultPost.data.tags || []))];
  return tags.map((tag) => ({ params: { tag: slugifyTag(tag) } }));
}

const { tag } = Astro.params;
const posts = (await getBlogPostGroups()).filter((post) =>
  (post.defaultPost.data.tags || []).some((item) => slugifyTag(item) === tag)
);
const meta = getTagMeta(tag);
---

<SiteShell bodyClass="blog-list-page" title={meta.title} description={meta.description}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`Tag: ${tag} feed`} href={`/rss/tag/${tag}.xml`} />
  </Fragment>

  <BlogLogHeader
    title={meta.title}
    description={meta.description}
    label="Tag"
  />
  <BlogPostList posts={posts} title="Tagged posts" />
</SiteShell>
