---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getBlogPostGroups, getBlogLanguageMeta, getBlogSection, type BlogPostGroup } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getBlogPostGroups();
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = BlogPostGroup;

const postGroup = Astro.props as Props;
const posts = (await getBlogPostGroups()).filter((post) => getBlogSection(post) === getBlogSection(postGroup));
const index = posts.findIndex((post) => post.slug === postGroup.slug);
const prev = index < posts.length - 1
  ? { slug: posts[index + 1].slug, title: posts[index + 1].defaultPost.data.title }
  : null;
const next = index > 0
  ? { slug: posts[index - 1].slug, title: posts[index - 1].defaultPost.data.title }
  : null;

const renderedContent = await Promise.all(
  postGroup.languages.map(async (language) => {
    const entry = postGroup.translations[language];

    if (!entry) {
      return null;
    }

    const { Content } = await render(entry);

    return {
      language,
      Content,
    };
  })
);
const languageContent = renderedContent.filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<BlogPost
  postGroup={postGroup}
  languageMeta={getBlogLanguageMeta(postGroup)}
  prevPost={prev}
  nextPost={next}
>
  {languageContent.map(({ language, Content }) => (
    <div
      data-blog-content-lang={language}
      hidden={language !== postGroup.defaultLanguage}
    >
      <Content />
    </div>
  ))}
</BlogPost>
