---
import SiteShell from '../../../components/SiteShell.astro';
import BlogLogHeader from '../../../components/blog/BlogLogHeader.astro';
import BlogPostList from '../../../components/blog/BlogPostList.astro';
import { getCategoryMeta, slugifyCategory } from '../../../data/categories';
import { getBlogPostGroups } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getBlogPostGroups();
  const categories = [
    ...new Set(
      posts
        .map((post) => post.defaultPost.data.category || null)
        .filter((value): value is string => Boolean(value))
        .map((name) => slugifyCategory(name))
    ),
  ];
  return categories.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const posts = (await getBlogPostGroups()).filter(
  (post) => slugifyCategory(post.defaultPost.data.category || '') === category
);
const meta = getCategoryMeta(category);
---

<SiteShell bodyClass="blog-list-page" title={`${meta.title} - Category`} description={meta.description}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`Category: ${category} feed`} href={`/rss/category/${category}.xml`} />
  </Fragment>

  <BlogLogHeader
    title={meta.title}
    description={meta.description}
    label="Category"
  />
  <BlogPostList posts={posts} title="Category posts" />
</SiteShell>
