---
import SiteShell from '../../../components/SiteShell.astro';
import BlogLogHeader from '../../../components/blog/BlogLogHeader.astro';
import BlogPostList from '../../../components/blog/BlogPostList.astro';
import { slugifyTag as slugify } from '../../../lib/slug';
import { getBlogPostGroups } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getBlogPostGroups();
  const authorSlugs = [
    ...new Set(posts.map((post) => slugify(post.defaultPost.data.author || 'Jay Yu'))),
  ];
  return authorSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const posts = (await getBlogPostGroups()).filter(
  (post) => slugify(post.defaultPost.data.author || 'Jay Yu') === slug
);
const authorName = posts[0]?.defaultPost.data.author || 'Jay Yu';
---

<SiteShell bodyClass="blog-list-page" title={`Articles by ${authorName}`} description={`Posts written by ${authorName}.`}>
  <BlogLogHeader
    title={`Author / ${authorName}`}
    description="A filtered author view."
    label="Author"
  />
  <BlogPostList posts={posts} title="Posts" />
</SiteShell>
